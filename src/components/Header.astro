---
const links = [
  { href: "#programacion", label: "Programación" },
  { href: "#planes", label: "Planes" },
  { href: "#aportar", label: "Aportar" },
  { href: "#beneficios", label: "Beneficios" },
];
---

<header
  id="site-header"
  class="fixed top-0 z-40 w-full border-b border-transparent"
>
  <div class="mx-auto flex h-16 w-full max-w-screen-2xl items-center justify-between gap-2 px-3 sm:h-[4.25rem] sm:gap-4 sm:px-6 lg:px-10">
    <a href="#top" class="flex shrink-0 items-center rounded-md focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-lime" aria-label="Nenasas, ir al inicio">
      <img
        src="/logo-nenasas.png"
        alt="Nenasas"
        width="1400"
        height="676"
        class="h-9 w-auto sm:h-11"
      />
    </a>

    <div class="flex min-w-0 items-center gap-1.5 md:gap-6 lg:gap-8">
      <a
        class="group inline-flex items-center gap-1 whitespace-nowrap rounded-pill border border-white px-2 py-1.5 text-xs font-semibold text-white transition hover:border-lime hover:text-lime focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-lime sm:gap-2 sm:px-4 sm:py-2 sm:text-sm"
        href="https://www.youtube.com/@Nenasasenvivo?sub_confirmation=1"
        target="_blank"
        rel="noopener noreferrer"
      >
        <svg class="size-4 text-[#ff0000] transition-colors group-hover:text-lime sm:size-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path fill-rule="evenodd" d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"></path>
        </svg>
        Suscribite en YouTube
        <span class="sr-only"> (se abre en una pestaña nueva)</span>
      </a>

      <nav class="hidden items-center gap-6 text-sm font-medium text-white md:flex lg:gap-8" aria-label="Secciones">
        {links.map((link) => (
          <a class="rounded-md px-1 py-2 transition-colors hover:text-lime focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-lime" href={link.href}>
            {link.label}
          </a>
        ))}
      </nav>

      <button
        id="menu-btn"
        type="button"
        class="inline-flex size-10 shrink-0 items-center justify-center rounded-pill border border-white/30 text-white focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-lime md:hidden"
        aria-controls="mobile-nav"
        aria-expanded="false"
        aria-label="Abrir menú"
      >
        <svg width="18" height="14" viewBox="0 0 18 14" fill="none" aria-hidden="true">
          <path d="M1 1h16M1 7h16M1 13h16" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
        </svg>
      </button>
    </div>
  </div>

  <nav
    id="mobile-nav"
    class="hidden border-t border-white/15 bg-brand px-4 py-3 md:hidden"
    aria-label="Secciones"
  >
    <ul class="flex flex-col gap-1 text-base font-medium text-white">
      {links.map((link) => (
        <li>
          <a class="block rounded-lg px-3 py-2 hover:bg-white/10 hover:text-lime focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-lime" href={link.href}>
            {link.label}
          </a>
        </li>
      ))}
    </ul>
  </nav>
</header>

<script>
  const header = document.getElementById("site-header");
  const btn = document.getElementById("menu-btn");
  const panel = document.getElementById("mobile-nav");
  const hero = document.getElementById("hero");

  const paint = () => {
    if (!header) return;
    const menuOpen = btn?.getAttribute("aria-expanded") === "true";
    const range = Math.max((hero?.offsetHeight ?? window.innerHeight) - header.offsetHeight, 1);
    const p = menuOpen ? 1 : Math.min(Math.max(window.scrollY / range, 0), 1);
    header.style.backgroundColor = `rgb(79 37 164 / ${p})`;
    header.style.borderColor = `rgb(255 255 255 / ${0.15 * p})`;
  };

  const setOpen = (open: boolean) => {
    panel?.classList.toggle("hidden", !open);
    btn?.setAttribute("aria-expanded", String(open));
    btn?.setAttribute("aria-label", open ? "Cerrar menú" : "Abrir menú");
    paint();
  };

  btn?.addEventListener("click", () => {
    const open = btn.getAttribute("aria-expanded") !== "true";
    setOpen(open);
  });

  panel?.querySelectorAll("a").forEach((anchor) => {
    anchor.addEventListener("click", () => setOpen(false));
  });

  document.addEventListener("keydown", (event) => {
    if (event.key !== "Escape" || btn?.getAttribute("aria-expanded") !== "true") return;
    setOpen(false);
    btn?.focus();
  });

  window.addEventListener("scroll", paint, { passive: true });
  window.addEventListener("resize", paint);
  paint();
</script>

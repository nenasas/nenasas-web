---
const links = [
  { href: "#planes", label: "Planes" },
  { href: "#aportar", label: "Aportar" },
  { href: "#faq", label: "FAQ" },
];
---

<header
  class="sticky top-0 z-40 border-b border-line bg-paper"
>
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-4 px-4 sm:h-[4.25rem] sm:px-6">
    <a href="#top" class="flex shrink-0 items-center" aria-label="Nenasas, ir al inicio">
      <img
        src="/logo-nenasas.jpg"
        alt="Nenasas"
        width="1600"
        height="800"
        class="h-10 w-auto rounded-md sm:h-11"
      />
    </a>

    <nav class="hidden items-center gap-8 text-sm font-medium text-ink md:flex" aria-label="Secciones">
      {links.map((link) => (
        <a class="transition-colors hover:text-brand" href={link.href}>
          {link.label}
        </a>
      ))}
    </nav>

    <button
      id="menu-btn"
      type="button"
      class="inline-flex size-10 items-center justify-center rounded-pill border border-line bg-white text-ink md:hidden"
      aria-controls="mobile-nav"
      aria-expanded="false"
      aria-label="Abrir menú"
    >
      <span class="sr-only">Menú</span>
      <svg width="18" height="14" viewBox="0 0 18 14" fill="none" aria-hidden="true">
        <path d="M1 1h16M1 7h16M1 13h16" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
      </svg>
    </button>
  </div>

  <nav
    id="mobile-nav"
    class="hidden border-t border-line bg-paper px-4 py-3 md:hidden"
    aria-label="Secciones"
  >
    <ul class="flex flex-col gap-1 text-base font-medium">
      {links.map((link) => (
        <li>
          <a class="block rounded-lg px-3 py-2 hover:bg-brand-soft" href={link.href}>
            {link.label}
          </a>
        </li>
      ))}
    </ul>
  </nav>
</header>

<script>
  const btn = document.getElementById("menu-btn");
  const panel = document.getElementById("mobile-nav");

  const setOpen = (open: boolean) => {
    panel?.classList.toggle("hidden", !open);
    btn?.setAttribute("aria-expanded", String(open));
    btn?.setAttribute("aria-label", open ? "Cerrar menú" : "Abrir menú");
  };

  btn?.addEventListener("click", () => {
    const open = btn.getAttribute("aria-expanded") !== "true";
    setOpen(open);
  });

  panel?.querySelectorAll("a").forEach((anchor) => {
    anchor.addEventListener("click", () => setOpen(false));
  });
</script>

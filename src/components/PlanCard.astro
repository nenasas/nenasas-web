---
interface Props {
  name: string;
  description: string;
  href: string;
  price: string;
  emoji: string;
}

const { name, description, href, price, emoji } = Astro.props;
const spokenPrice = price.replaceAll(".", "");
---

<article
  class="flex h-full flex-col rounded-card border border-line bg-sand p-6 shadow-[0_1px_0_rgba(22,18,28,0.04)] transition duration-200 hover:-translate-y-1 hover:border-brand hover:shadow-[0_16px_32px_-20px_rgba(79,37,164,0.45)] sm:p-7"
>
  <h3 class="font-display text-3xl font-black tracking-tight text-brand uppercase sm:text-4xl">
    <span class="inline-block not-italic" aria-hidden="true">{emoji}</span>
    <span class="italic"> {name}</span>
  </h3>
  <p class="mt-3 font-display text-3xl font-extrabold tracking-tight text-ink">
    ${price}<span class="text-lg font-semibold text-muted">/mes</span>
  </p>
  <p class="mt-3 flex-1 text-[0.95rem] leading-relaxed text-muted">{description}</p>
  <a
    href={href}
    aria-label={`Elegir ${name}, ${spokenPrice} pesos por mes`}
    class="mt-6 inline-flex w-full items-center justify-center rounded-pill bg-lime px-4 py-3 text-sm font-semibold text-ink transition hover:bg-flame focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand focus-visible:ring-offset-2"
  >
    Elegir plan
  </a>
</article>

---
import Analytics from "@vercel/analytics/astro";
import "../styles/global.css";
import Header from "../components/Header.astro";
import PlanCard from "../components/PlanCard.astro";

const title = "Nenasas | Streaming de humor en vivo en Argentina";
const description =
  "Streaming de humor en vivo con Carola Oyarbide, Nahuel Puyaps y Lucas Roman. Nenasas, Mañanasas, Nenasas a Laburar y Psicopolítica, en YouTube, desde Argentina.";

const pageUrl = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
const imageUrl = Astro.site ? new URL("/logo-nenasas.jpg", Astro.site).href : "/logo-nenasas.jpg";

const plans = [
  {
    name: "Nenasa Cautelosa",
    emoji: "🫣",
    price: "6.000",
    href: "https://mpago.la/1Wg57Pp",
    description: "Dale, no seas tímida.",
  },
  {
    name: "Nenasa Impulsiva",
    emoji: "⚡",
    price: "8.000",
    href: "https://mpago.la/1xMSGKi",
    description: "Mala pero cutie.",
  },
  {
    name: "Nenasa Fancy",
    emoji: "💅",
    price: "12.000",
    href: "https://mpago.la/19XTmHo",
    description: "You better work bitch.",
  },
];

const shows = [
  {
    name: "Nenasas",
    host: "",
    when: "Lunes, 20 a 22",
    line: "Tu programa favorito. Tu idioma nativo.",
    image: "/hero/live-trio.jpg",
    imagePosition: "object-[50%_32%]",
    eyebrow: "Lucas · Carola · Puyaps",
  },
  {
    name: "Mañanasas",
    host: "",
    when: "Martes y jueves, 11 a 12",
    line: "Toda la información que no necesitas.",
    eyebrow: "Lucas Roman",
    image: "/hero/live-mustache.jpg",
    imageFrame: "top-[-27%] right-0 h-[120%] w-auto max-w-none aspect-[1024/980] translate-x-[46%]",
  },
  {
    name: "Nenasas a Laburar",
    host: "",
    when: "Miércoles, 17 a 18",
    line: "¿Carola puede ser una doctora también?",
    eyebrow: "Carola Oyarbide",
    image: "/hero/live-poetry.jpg",
    imageFrame: "top-[-2%] right-0 h-[80%] w-auto max-w-none aspect-[1024/682] translate-x-[46%]",
  },
  {
    name: "Psicopolítica",
    host: "",
    when: "Viernes, 19 a 20, quincenal",
    line: "Imprescindible como respirar.",
    eyebrow: "Nahuel Puyaps",
    image: "/hero/live-cap.jpg",
    imageFrame: "top-[-14%] right-0 h-[96%] w-auto max-w-none aspect-[1024/963] translate-x-[28%]",
  },
];

const heroSlides = [
  {
    src: "/hero/live-trio.jpg",
    alt: "Los tres de Nenasas en vivo, con micrófono, frente al logo proyectado",
    width: 1024,
    height: 682,
  },
  {
    src: "/hero/vanity-mirror.jpg",
    alt: "Los tres de Nenasas juntos en un espejo de camerino cubierto de stickers",
    width: 1024,
    height: 682,
  },
  {
    src: "/hero/live-cap.jpg",
    alt: "Uno de Nenasas sentado en el escenario, con gorra y micrófono",
    width: 1024,
    height: 963,
  },
  {
    src: "/hero/live-woman-mic.jpg",
    alt: "Una de Nenasas en el escenario, con micrófono, y el logo proyectado atrás",
    width: 1024,
    height: 682,
  },
  {
    src: "/hero/live-poetry.jpg",
    alt: "Nenasas en el Jam de poesía, ella al micrófono con el puño en alto",
    width: 1024,
    height: 682,
  },
  {
    src: "/hero/live-mustache.jpg",
    alt: "Uno de Nenasas al micrófono, sonriendo en el escenario",
    width: 1024,
    height: 980,
  },
  {
    src: "/hero/merch-selfie.jpg",
    alt: "Los tres de Nenasas con remeras del logo",
    width: 1024,
    height: 768,
  },
  {
    src: "/hero/live-letters.jpg",
    alt: "Los tres de Nenasas en el escenario, junto al cartel de letras NE NA SA",
    width: 1024,
    height: 924,
  },
  {
    src: "/hero/live-wig.jpg",
    alt: "Dos de Nenasas en el Jam de poesía, pasando una peluca en el escenario",
    width: 1024,
    height: 835,
  },
];

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "PerformingGroup",
      name: "Nenasas",
      description,
      url: pageUrl,
      image: Astro.site ? imageUrl : undefined,
      email: "nenasasenvivo@gmail.com",
      sameAs: [
        "https://www.youtube.com/@Nenasasenvivo",
        "https://www.instagram.com/nenasasenvivo",
      ],
      member: [
        { "@type": "Person", name: "Carola Oyarbide" },
        { "@type": "Person", name: "Nahuel Puyaps" },
        { "@type": "Person", name: "Lucas Roman" },
      ],
    },
    {
      "@type": "WebSite",
      name: "Nenasas",
      url: pageUrl,
      inLanguage: "es-AR",
      description,
    },
    {
      "@type": "ItemList",
      name: "Grilla de Nenasas",
      itemListElement: shows.map((show, index) => ({
        "@type": "ListItem",
        position: index + 1,
        item: {
          "@type": "CreativeWork",
          name: show.name,
          description: [show.eyebrow, show.when, show.line].filter(Boolean).join(". "),
        },
      })),
    },
  ],
};

const structuredDataJson = JSON.stringify(structuredData).replaceAll("<", "\\u003c");
---

<html lang="es-AR">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" href="/favicon-32.png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    {pageUrl && <link rel="canonical" href={pageUrl} />}
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_AR" />
    <meta property="og:site_name" content="Nenasas" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {pageUrl && <meta property="og:url" content={pageUrl} />}
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:alt" content="Logo de Nenasas, tres siluetas sobre violeta" />
    <meta property="og:image:width" content="1600" />
    <meta property="og:image:height" content="800" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="twitter:image:alt" content="Logo de Nenasas, tres siluetas sobre violeta" />
    <meta name="theme-color" content="#4F25A4" />
    <script is:inline type="application/ld+json" set:html={structuredDataJson} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:ital,wght@0,600;0,800;0,900;1,800;1,900&family=Outfit:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
    <Analytics />
  </head>
  <body id="top" class="antialiased">
    <a
      href="#contenido"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-pill focus:bg-lime focus:px-4 focus:py-2 focus:text-ink"
    >
      Saltar al contenido
    </a>
    <Header />

    <main id="contenido">
      <section
        id="hero"
        class="relative h-svh bg-ink"
        aria-roledescription="carrusel"
        aria-label="Fotos de Nenasas en vivo"
      >
        <div
          id="hero-track"
          class="hero-track flex h-full min-h-0 snap-x snap-mandatory overflow-x-auto overflow-y-hidden"
        >
          {
            heroSlides.map((slide, index) => (
              <div class="relative h-full min-h-0 w-full shrink-0 snap-center overflow-hidden" data-hero-slide>
                <img
                  src={slide.src}
                  alt={slide.alt}
                  width={slide.width}
                  height={slide.height}
                  fetchpriority={index === 0 ? "high" : undefined}
                  loading={index === 0 ? "eager" : "lazy"}
                  class="absolute inset-0 size-full object-cover object-center"
                />
              </div>
            ))
          }
        </div>

        <div class="pointer-events-none absolute inset-0 bg-gradient-to-r from-ink/80 via-ink/35 to-transparent"></div>
        <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-ink/70 to-transparent lg:from-ink/40"></div>

        <div class="pointer-events-none absolute inset-0 flex items-end lg:items-center lg:pt-20">
          <div class="mx-auto w-full max-w-screen-2xl px-4 pb-16 sm:px-6 lg:px-16 lg:pb-20">
            <p class="flex items-center gap-2 text-xs font-semibold tracking-[0.18em] text-lime uppercase">
              <span class="star" aria-hidden="true"></span>
              Humor · Actualidad · Comunidad
            </p>
            <h1 class="mt-4 max-w-xl font-display text-5xl leading-[0.95] font-black tracking-tight text-white italic uppercase sm:text-6xl lg:text-7xl">
              Nenasas Streaming en vivo
            </h1>
            <p class="mt-5 max-w-md text-lg leading-relaxed text-white">
              Nenasas es un nuevo idioma, es un streaming, es humor. Nenasas sos vos.
            </p>
            <div class="mt-8 grid w-fit max-w-full grid-cols-1 gap-3 sm:grid-cols-2">
              <a
                href="#planes"
                class="pointer-events-auto inline-flex items-center justify-center whitespace-nowrap rounded-pill bg-lime px-6 py-3 text-sm font-semibold text-ink transition hover:bg-flame focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white focus-visible:ring-offset-2 focus-visible:ring-offset-ink"
              >
                Quiero ser socio
              </a>
              <a
                href="https://www.youtube.com/@Nenasasenvivo?sub_confirmation=1"
                target="_blank"
                rel="noopener noreferrer"
                class="group pointer-events-auto inline-flex items-center justify-center gap-2 whitespace-nowrap rounded-pill border border-white px-6 py-3 text-sm font-semibold text-white transition hover:border-lime hover:text-lime focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white focus-visible:ring-offset-2 focus-visible:ring-offset-ink"
              >
                <svg class="size-5 shrink-0 text-[#ff0000] transition-colors group-hover:text-lime" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path fill-rule="evenodd" d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"></path>
                </svg>
                Suscribite en YouTube
                <span class="sr-only"> (se abre en una pestaña nueva)</span>
              </a>
            </div>
          </div>
        </div>

        <button
          id="hero-prev"
          type="button"
          class="absolute top-20 left-3 z-10 hidden size-10 items-center justify-center rounded-pill border border-white/30 bg-ink/50 text-white hover:border-lime hover:text-lime focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-lime sm:left-4 md:inline-flex lg:top-1/2 lg:-translate-y-1/2"
          aria-label="Foto anterior"
        >
          <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
            <path d="M11.5 4.5 7 9l4.5 4.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
        </button>
        <button
          id="hero-next"
          type="button"
          class="absolute top-20 right-3 z-10 hidden size-10 items-center justify-center rounded-pill border border-white/30 bg-ink/50 text-white hover:border-lime hover:text-lime focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-lime sm:right-4 md:inline-flex lg:top-1/2 lg:-translate-y-1/2"
          aria-label="Foto siguiente"
        >
          <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
            <path d="M6.5 4.5 11 9l-4.5 4.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
        </button>
      </section>

      <script>
        const hero = document.getElementById("hero");
        const track = document.getElementById("hero-track");
        const prev = document.getElementById("hero-prev");
        const next = document.getElementById("hero-next");
        const count = track?.querySelectorAll("[data-hero-slide]").length ?? 0;

        if (hero && track && count) {
          const motion = window.matchMedia("(prefers-reduced-motion: reduce)");
          const indexFromScroll = () => Math.round(track.scrollLeft / track.clientWidth);

          const goTo = (i: number) => {
            const n = ((i % count) + count) % count;
            track.scrollTo({
              left: n * track.clientWidth,
              behavior: motion.matches ? "auto" : "smooth",
            });
          };

          prev?.addEventListener("click", () => goTo(indexFromScroll() - 1));
          next?.addEventListener("click", () => goTo(indexFromScroll() + 1));

          if (!motion.matches) {
            let paused = false;
            let timer = 0;

            const play = () => {
              window.clearInterval(timer);
              if (paused || document.hidden) return;
              timer = window.setInterval(() => goTo(indexFromScroll() + 1), 5000);
            };

            const stop = () => {
              window.clearInterval(timer);
              timer = 0;
            };

            hero.addEventListener("pointerenter", () => {
              paused = true;
              stop();
            });
            hero.addEventListener("pointerleave", () => {
              paused = false;
              play();
            });
            hero.addEventListener("focusin", () => {
              paused = true;
              stop();
            });
            hero.addEventListener("focusout", (event) => {
              if (hero.contains(event.relatedTarget as Node | null)) return;
              paused = false;
              play();
            });
            document.addEventListener("visibilitychange", () => {
              if (document.hidden) stop();
              else play();
            });
            prev?.addEventListener("click", play);
            next?.addEventListener("click", play);
            play();
          }
        }
      </script>

      <section aria-labelledby="bio-title">
        <div class="mx-auto w-full max-w-screen-2xl px-4 py-16 sm:px-6 sm:py-20 lg:px-10">
          <p class="flex items-center gap-2 text-xs font-semibold tracking-[0.18em] text-brand uppercase">
            <span class="star" aria-hidden="true"></span>
            Quiénes somos
          </p>
          <h2 id="bio-title" class="mt-3 max-w-3xl font-display text-4xl font-black tracking-tight text-ink italic uppercase sm:text-5xl">
            Una nenasa nunca está sola
          </h2>
          <p class="mt-6 max-w-2xl text-lg leading-relaxed text-ink">
            Somos Carola Oyarbide, Nahuel Puyaps y Lucas Roman. Tres amigos que queremos compartir la alegría con vos. Por eso armamos esta programación de humor en vivo, chiquita, para estar juntas y lo más cerquita posible.
          </p>
          <figure class="mt-10">
            <img
              src="/hosts-selfie.jpg"
              alt="Carola Oyarbide, Nahuel Puyaps y Lucas Roman con remeras de Nenasas"
              width="1280"
              height="960"
              class="aspect-[16/9] w-full rounded-card object-cover object-[50%_35%] ring-1 ring-line"
            />
          </figure>
        </div>
      </section>

      <section id="programacion" class="scroll-mt-24" aria-labelledby="programacion-title">
        <div class="mx-auto w-full max-w-screen-2xl px-4 py-16 sm:px-6 sm:py-20 lg:px-10">
          <p class="flex items-center gap-2 text-xs font-semibold tracking-[0.18em] text-brand uppercase">
            <span class="star" aria-hidden="true"></span>
            Programación
          </p>
          <h2 id="programacion-title" class="mt-3 font-display text-4xl font-black tracking-tight text-ink italic uppercase sm:text-5xl">
            Grilla Nenasa
          </h2>
          <div class="mt-10 grid grid-cols-1 gap-4 lg:grid-cols-4">
            {
              shows.map((show) => (
                <article
                  class:list={[
                    "relative flex h-full flex-col overflow-hidden rounded-card border p-6 shadow-[0_1px_0_rgba(22,18,28,0.04)] sm:p-7",
                    show.image
                      ? "min-h-72 justify-end border-white/15 bg-[#05030a]"
                      : "border-line bg-white",
                  ]}
                >
                  {
                    show.image && (
                      <>
                        <img
                          src={show.image}
                          alt=""
                          width="1024"
                          height="768"
                          loading="lazy"
                          class:list={[
                            "absolute object-cover",
                            show.imageFrame ?? ["inset-0 size-full", show.imagePosition],
                          ]}
                        />
                        <div
                          class="absolute inset-0 bg-gradient-to-t from-ink/95 via-ink/55 to-transparent"
                          aria-hidden="true"
                        />
                      </>
                    )
                  }
                  <div class:list={["relative", show.image && "mt-auto"]}>
                    {
                      show.eyebrow && (
                        <p class="text-xs font-semibold tracking-[0.14em] text-white uppercase">{show.eyebrow}</p>
                      )
                    }
                    <h3
                      class:list={[
                        "font-display text-3xl font-black tracking-tight italic uppercase lg:text-2xl xl:text-3xl",
                        show.image ? "text-lime" : "text-brand",
                        show.eyebrow && "mt-1",
                      ]}
                    >
                      {show.name}
                    </h3>
                    {show.host && (
                      <p
                        class:list={[
                          "text-[0.95rem] font-semibold",
                          show.image ? "mt-1 text-white" : "mt-3 text-ink",
                        ]}
                      >
                        {show.host}
                      </p>
                    )}
                    <p
                      class:list={[
                        "font-display text-2xl font-extrabold tracking-tight",
                        show.image || show.host ? "mt-1" : "mt-3",
                        show.image ? "text-white" : "text-ink",
                      ]}
                    >
                      {show.when}
                    </p>
                    <p
                      class:list={[
                        "text-[0.95rem] leading-snug",
                        show.image ? "mt-1 text-white/85" : "mt-3 leading-relaxed text-muted",
                      ]}
                    >
                      {show.line}
                    </p>
                  </div>
                </article>
              ))
            }
          </div>
        </div>
      </section>

      <section id="planes" class="scroll-mt-24" aria-labelledby="planes-title">
        <div class="mx-auto w-full max-w-screen-2xl px-4 py-16 sm:px-6 sm:py-20 lg:px-10">
          <p class="flex items-center gap-2 text-xs font-semibold tracking-[0.18em] text-brand uppercase">
            <span class="star" aria-hidden="true"></span>
            Planes
          </p>
          <h2 id="planes-title" class="mt-3 font-display text-4xl font-black tracking-tight text-ink italic uppercase sm:text-5xl">
            Maneras de bancar a Nenasas
          </h2>
          <p class="mt-3 max-w-xl text-muted">Lo bajás cuando quieras, desde tu cuenta.</p>
          <div class="mt-10 grid gap-4 md:grid-cols-3">
            {
              plans.map((plan) => (
                <PlanCard
                  name={plan.name}
                  description={plan.description}
                  href={plan.href}
                  price={plan.price}
                  emoji={plan.emoji}
                />
              ))
            }
          </div>
          <div id="aportar" class="mt-4 grid scroll-mt-24 gap-4 md:grid-cols-2">
            <article
              class="flex h-full flex-col rounded-card border border-line bg-sand p-6 shadow-[0_1px_0_rgba(22,18,28,0.04)] transition duration-200 hover:-translate-y-1 hover:border-brand hover:shadow-[0_16px_32px_-20px_rgba(79,37,164,0.45)] sm:p-7"
            >
              <h3 class="font-display text-3xl font-black tracking-tight text-brand uppercase sm:text-4xl">
                <span class="italic">Aporte único</span>
              </h3>
              <p class="mt-3 flex-1 text-[0.95rem] leading-relaxed text-muted">
                Un aporte único también suma. El monto lo ponés al pagar.
              </p>
              <a
                href="https://link.mercadopago.com.ar/nenasas"
                class="mt-6 inline-flex w-full items-center justify-center rounded-pill bg-lime px-8 py-3 text-sm font-semibold text-ink transition hover:bg-flame focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand focus-visible:ring-offset-2"
              >
                Mercado Pago
              </a>
            </article>
            <article
              class="flex h-full flex-col rounded-card border border-line bg-sand p-6 shadow-[0_1px_0_rgba(22,18,28,0.04)] transition duration-200 hover:-translate-y-1 hover:border-brand hover:shadow-[0_16px_32px_-20px_rgba(79,37,164,0.45)] sm:p-7"
            >
              <h3 class="font-display text-3xl font-black tracking-tight text-brand uppercase sm:text-4xl">
                <span class="italic">Si estás en el exterior</span>
              </h3>
              <a
                href="https://www.paypal.com/donate/?hosted_button_id=FQH829UVDTUPS"
                aria-label="PayPal"
                class="mt-auto inline-flex self-start rounded-md pt-6 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand focus-visible:ring-offset-2"
              >
                <img src="/paypal.svg" alt="PayPal" width="170" height="48" class="h-10 w-auto" />
              </a>
            </article>
          </div>
        </div>
      </section>

      <section id="beneficios" class="scroll-mt-24" aria-labelledby="beneficios-title">
        <div class="mx-auto w-full max-w-screen-2xl px-4 py-16 sm:px-6 sm:py-20 lg:px-10">
          <p class="flex items-center gap-2 text-xs font-semibold tracking-[0.18em] text-brand uppercase">
            <span class="star" aria-hidden="true"></span>
            Beneficios
          </p>
          <h2 id="beneficios-title" class="mt-3 font-display text-4xl font-black tracking-tight text-ink italic uppercase sm:text-5xl">
            Para quien se suscribe
          </h2>
          <p class="mt-3 max-w-xl text-muted">Una nenasa merece beneficios. Pronto tendremos de todo para vos.</p>
        </div>
      </section>
    </main>

    <a
      id="to-top"
      href="#top"
      hidden
      class="fixed right-4 bottom-4 z-40 inline-flex size-12 items-center justify-center rounded-pill bg-brand text-white shadow-[0_16px_32px_-20px_rgba(22,18,28,0.6)] hover:bg-ink focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-lime focus-visible:ring-offset-2"
      aria-label="Volver arriba"

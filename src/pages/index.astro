---
import "../styles/global.css";
import Header from "../components/Header.astro";
import PlanCard from "../components/PlanCard.astro";
import FaqItem from "../components/FaqItem.astro";

const title = "Nenasas — humor y magazine en vivo";
const description =
  "Nenasas es un live propio de humor y magazine. Sin beneficios: si te copa el proyecto, lo bancás por buena onda.";

const plans = [
  {
    name: "Socio",
    description: "El aporte mensual de base. Entrás, bancás el live y seguís con tu vida.",
  },
  {
    name: "Socio+",
    description:
      "Un escalón más por mes. Sigue sin haber contraprestación: es más espalda para que el programa exista.",
    featured: true,
  },
  {
    name: "Impulsor",
    description: "Para quien quiere empujar más fuerte. Tampoco hay beneficios. Hay más Nenasas posibles.",
  },
];

const reasons = [
  {
    title: "El proyecto",
    body: "Nenasas es un programa de humor y magazine. Lo hacemos nosotros, con la energía de un living y la picardía de un escenario.",
  },
  {
    title: "El live",
    body: "No es un recorte ni un highlight. Es el programa entero, cada vez que sale al aire. Si estás, estás.",
  },
  {
    title: "Por qué aportar",
    body: "No hay merch, ni acceso VIP, ni un sticker mágico. Bancás el proyecto porque te gusta que exista. Punto.",
  },
];

const faqs = [
  {
    question: "¿Hay beneficios?",
    answer:
      "No. Cero. Ni un emote, ni un behind the scenes exclusivo. Aportás porque te gusta el programa.",
  },
  {
    question: "¿Cuándo se cobra?",
    answer:
      "Todavía no. Estamos armando los medios de pago. Cuando esté, lo avisamos. Por ahora los botones dicen Próximamente y es en serio.",
  },
  {
    question: "¿ARS e internacional?",
    answer:
      "Sí. En Argentina va a ser Mercado Pago. Para el resto, un procesador internacional (todavía TBD). Mismos planes, distinta vía.",
  },
  {
    question: "¿Puedo cancelar?",
    answer: "Sí. Cuando esté la suscripción, la bajás cuando quieras. Sin letra chica dramática.",
  },
  {
    question: "¿Qué programas son?",
    answer:
      "Humor y magazine, en vivo, propios. No es un recorte de otro lado. Somos las tres siluetas del logo, con micrófono.",
  },
];
---

<html lang="es-AR">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="/logo-nenasas.jpg" />
    <meta property="og:locale" content="es_AR" />
    <meta name="theme-color" content="#4F25A4" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:ital,wght@0,600;0,800;0,900;1,800;1,900&family=Outfit:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
  </head>
  <body id="top" class="antialiased">
    <a
      href="#contenido"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-pill focus:bg-brand focus:px-4 focus:py-2 focus:text-white"
    >
      Saltar al contenido
    </a>
    <Header />

    <main id="contenido">
      <section class="overflow-hidden">
        <div class="mx-auto grid max-w-6xl items-center gap-10 px-4 py-12 sm:px-6 sm:py-16 lg:grid-cols-[1.05fr_0.95fr] lg:gap-14 lg:py-20">
          <div>
            <p class="animate-rise flex items-center gap-2 text-xs font-semibold tracking-[0.18em] text-brand uppercase delay-75">
              <span class="star" aria-hidden="true"></span>
              Humor · magazine · en vivo
            </p>
            <h1
              class="animate-rise mt-4 font-display text-5xl leading-[0.95] font-black tracking-tight text-brand italic uppercase delay-100 sm:text-6xl lg:text-7xl"
            >
              Humor y magazine, en vivo.
            </h1>
            <p class="animate-rise mt-5 max-w-md text-lg leading-relaxed text-muted delay-150">
              Nenasas es un live propio. No hay beneficios: si te copa el proyecto, lo bancás. Así de simple.
            </p>
            <a
              href="#planes"
              class="animate-rise mt-8 inline-flex items-center rounded-pill bg-brand px-6 py-3 text-sm font-semibold text-white delay-200 transition hover:bg-brand-deep"
            >
              Quiero ser socio
            </a>
          </div>
          <figure class="animate-rise delay-200">
            <img
              src="/stage-live.jpg"
              alt="Los tres de Nenasas en un live, con micrófono, frente al logo proyectado"
              width="1600"
              height="1066"
              class="aspect-[3/2] w-full rounded-card object-cover shadow-[0_20px_50px_-24px_rgba(79,37,164,0.55)] ring-2 ring-lime"
            />
          </figure>
        </div>
      </section>

      <section class="bg-white" aria-labelledby="manifiesto-title">
        <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 sm:py-20">
          <p class="flex items-center gap-2 text-xs font-semibold tracking-[0.18em] text-brand uppercase">
            <span class="star" aria-hidden="true"></span>
            Por qué existe
          </p>
          <h2 id="manifiesto-title" class="mt-3 font-display text-4xl font-black tracking-tight text-ink italic uppercase sm:text-5xl">
            Un programa propio, sin contraprestación.
          </h2>
          <div class="mt-10 grid gap-4 md:grid-cols-3">
            {
              reasons.map((reason) => (
                <article class="rounded-card border border-line bg-paper p-6 transition duration-200 hover:-translate-y-1 hover:border-brand">
                  <h3 class="font-display text-2xl font-extrabold tracking-tight text-brand italic uppercase">
                    {reason.title}
                  </h3>
                  <p class="mt-3 text-[0.95rem] leading-relaxed text-muted">{reason.body}</p>
                </article>
              ))
            }
          </div>
          <figure class="mt-10">
            <img
              src="/hosts-selfie.jpg"
              alt="Los tres de Nenasas con remeras del logo"
              width="1280"
              height="960"
              class="aspect-[16/9] w-full rounded-card object-cover object-[50%_35%] ring-1 ring-line"
            />
          </figure>
        </div>
      </section>

      <section id="planes" class="scroll-mt-24" aria-labelledby="planes-title">
        <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 sm:py-20">
          <p class="flex items-center gap-2 text-xs font-semibold tracking-[0.18em] text-brand uppercase">
            <span class="star" aria-hidden="true"></span>
            Planes recurrentes
          </p>
          <h2 id="planes-title" class="mt-3 font-display text-4xl font-black tracking-tight text-ink italic uppercase sm:text-5xl">
            Tres maneras de bancar el live.
          </h2>
          <p class="mt-3 max-w-xl text-muted">Sin montos todavía. Elegís el nivel; el cobro viene después.</p>
          <div class="mt-10 grid gap-4 md:grid-cols-3">
            {
              plans.map((plan) => (
                <PlanCard name={plan.name} description={plan.description} featured={plan.featured} />
              ))
            }
          </div>
          <div class="mt-8 flex flex-wrap items-center gap-2">
            <span class="rounded-pill border border-line bg-white px-3 py-1.5 text-xs font-medium text-ink">
              Mercado Pago · ARS
            </span>
            <span class="rounded-pill border border-line bg-white px-3 py-1.5 text-xs font-medium text-ink">
              Internacional · TBD
            </span>
          </div>
        </div>
      </section>

      <section id="aportar" class="scroll-mt-24 bg-white" aria-labelledby="aportar-title">
        <div class="mx-auto max-w-6xl px-4 py-14 sm:px-6">
          <div class="rounded-card border border-line bg-paper px-6 py-8 sm:flex sm:items-center sm:justify-between sm:gap-10 sm:px-8">
            <div class="max-w-xl">
              <p class="flex items-center gap-2 text-xs font-semibold tracking-[0.18em] text-brand uppercase">
                <span class="star" aria-hidden="true"></span>
                Una sola vez
              </p>
              <h2 id="aportar-title" class="mt-2 font-display text-3xl font-black tracking-tight text-ink italic uppercase sm:text-4xl">
                ¿No te cierra lo mensual?
              </h2>
              <p class="mt-2 text-[0.95rem] text-muted">Un aporte único también suma. Misma lógica: sin beneficios, por buena onda.</p>
              <div class="mt-4 flex flex-wrap gap-2">
                <span class="rounded-pill border border-line bg-white px-3 py-1.5 text-xs font-medium text-ink">
                  Mercado Pago · ARS
                </span>
                <span class="rounded-pill border border-line bg-white px-3 py-1.5 text-xs font-medium text-ink">
                  Internacional · TBD
                </span>
              </div>
            </div>
            <button
              type="button"
              disabled
              class="mt-6 inline-flex w-full cursor-not-allowed flex-col items-center rounded-pill bg-ink/8 px-8 py-3 text-ink/45 sm:mt-0 sm:w-auto sm:min-w-44"
            >
              <span class="text-sm font-semibold">Aportar</span>
              <span class="text-xs">Próximamente</span>
            </button>
          </div>
        </div>
      </section>

      <section id="faq" class="scroll-mt-24" aria-labelledby="faq-title">
        <div class="mx-auto max-w-3xl px-4 py-16 sm:px-6 sm:py-20">
          <p class="flex items-center gap-2 text-xs font-semibold tracking-[0.18em] text-brand uppercase">
            <span class="star" aria-hidden="true"></span>
            Preguntas
          </p>
          <h2 id="faq-title" class="mt-3 font-display text-4xl font-black tracking-tight text-ink italic uppercase">
            Lo justo y necesario.
          </h2>
          <div class="mt-8">
            {faqs.map((faq) => <FaqItem question={faq.question} answer={faq.answer} />)}
          </div>
        </div>
      </section>
    </main>

    <footer class="bg-brand text-white">
      <div class="mx-auto flex max-w-6xl flex-col gap-8 px-4 py-12 sm:px-6 md:flex-row md:items-end md:justify-between">
        <div>
          <img
            src="/logo-nenasas.jpg"
            alt="Nenasas"
            width="1600"
            height="800"
            class="h-12 w-auto rounded-md"
          />
          <p class="mt-4 text-sm text-white/80">© Nenasas. Humor y magazine en vivo.</p>
        </div>
        <ul class="flex flex-col gap-2 text-sm sm:flex-row sm:gap-6">
          <li>
            <a class="underline decoration-lime/70 underline-offset-4 hover:text-lime" href="mailto:hola@nenasas.com">
              hola@nenasas.com
            </a>
          </li>
          <li>
            <a
              class="underline decoration-lime/70 underline-offset-4 hover:text-lime"
              href="https://www.instagram.com/nenasas"
              rel="noopener noreferrer"
            >
              Instagram
            </a>
          </li>
          <li>
            <a
              class="underline decoration-lime/70 underline-offset-4 hover:text-lime"
              href="https://www.youtube.com/@nenasas"
              rel="noopener noreferrer"
            >
              YouTube
            </a>
          </li>
        </ul>
      </div>
    </footer>
  </body>
</html>
